# ---------------------------------------------------------------------------
# School Fee & Payment Tracker — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Django ---
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (matches docker-compose.yml defaults) ---
POSTGRES_DB=schoolpay
POSTGRES_USER=schoolpay
POSTGRES_PASSWORD=schoolpay
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Set True to run Celery tasks inline without a worker (default in dev.py).
CELERY_TASK_ALWAYS_EAGER=False

# --- JWT (djangorestframework-simplejwt) ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- CORS ---
CORS_ALLOW_ALL_ORIGINS=True

# --- M-Pesa / Daraja sandbox (Phase 3) ---
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=your_sandbox_consumer_key
DARAJA_CONSUMER_SECRET=your_sandbox_consumer_secret
DARAJA_INITIATOR_PASSWORD=your_initiator_password
DARAJA_PASSKEY=your_online_checkout_passkey
DARAJA_SHORTCODE=174379
DARAJA_PAYBILL=your_paybill_number
# Secret token appended to callback URLs to protect webhooks.
DARAJA_CALLBACK_SECRET_TOKEN=change-me-to-a-strong-random-token

# --- Africa's Talking SMS (Phase 5) ---
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your_sandbox_api_key
AFRICASTALKING_SENDER_ID=SchoolPay

# --- Tenant ---
DEFAULT_SCHOOL_SLUG=demo-school